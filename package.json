{
  "name": "@crypto-hacks/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/persistence/migrate-cli.ts",
    "backtest": "tsx src/backtest/cli.ts",
    "fetch-history": "tsx src/marketdata/history-cli.ts",
    "compare-exits": "tsx src/backtest/compare-exits-cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "mongodb": "^6.21.0",
    "pino": "^9.4.0",
    "socket.io-client": "2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
